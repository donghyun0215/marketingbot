# Supabase (Vercel 환경변수에도 동일하게 등록)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
SUPABASE_SERVICE_ROLE_KEY=<secret key — 서버 전용, 절대 NEXT_PUBLIC_ 접두사 금지>

# LLM — 무료 티어로 운영. 제공자는 갈아끼울 수 있다 (lib/llm.ts)
LLM_PROVIDER=gemini
GEMINI_API_KEY=<aistudio.google.com/apikey 에서 무료 발급>
GEMINI_MODEL=gemini-3.6-flash
# 대안: LLM_PROVIDER=groq / GROQ_API_KEY=<console.groq.com 무료>
# 나중에 품질 비교용: LLM_PROVIDER=anthropic / ANTHROPIC_API_KEY=<유료>

# Telegram (Bolt 3)
TELEGRAM_BOT_TOKEN=<token>
TELEGRAM_CHAT_ID=<chat id>
